# Dependencias locales: se reinstalan dentro del contenedor con npm ci.
node_modules/

# Builds previos locales: se regeneran dentro del contenedor con npm run build.
dist/
.angular/

# Secretos y configuración local: nunca deben terminar dentro de la imagen.
.env
.env.*
!.env.example

# Control de versiones y metadatos que no aportan nada al build.
.git/
.gitignore

# Archivos de test, cobertura y logs, no necesarios en la imagen final.
coverage/
*.log
npm-debug.log*

# Editores / IDE
.vscode/
.idea/
