# Variables para docker-compose.yml (base de datos)
# No uses "root" en DB_USER: el entrypoint de la imagen mysql:8.0 lo rechaza,
# porque el usuario root ya se gestiona aparte con MYSQL_ROOT_PASSWORD.

#########################################
# APP
#########################################

APP_NAME=Mapa Social

PORT=3000

NODE_ENV=development

#########################################
# DATABASE
#########################################

DB_HOST=db

DB_PORT=3306

DB_USER=mapa_user

DB_PASS=mapa_password

DB_NAME=mapa_social

#########################################
# TYPEORM
#########################################

TYPEORM_LOGGING=true

TYPEORM_SYNCHRONIZE=false

#########################################
# JWT
#########################################

JWT_SECRET=CAMBIAR_ESTA_CLAVE_MUY_LARGA

JWT_EXPIRES=7d